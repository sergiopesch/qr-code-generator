{
  "name": "qr-code-generator",
  "version": "3.0.0",
  "description": "A lightweight browser-based QR code generator for fast event sharing and connection",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "audit:ci": "node scripts/audit-ci.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "qr-code",
    "qr-generator",
    "nextjs",
    "react",
    "typescript",
    "qr-code-styling"
  ],
  "author": "Sergio Peschiera <speschiera@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiopesch/qr-code-generator"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.7.0",
    "next": "16.2.11",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.20",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "brace-expansion@>=3 <6": "5.0.8",
    "js-yaml": "4.3.0",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "auditExceptions": {
    "GHSA-mh99-v99m-4gvg": {
      "expires": "2026-10-31",
      "reason": "Only the incompatible brace-expansion 5.x line is patched; existing consumers use trusted developer globs."
    }
  }
}
